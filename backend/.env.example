DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=300
JWT_ACCESS_SECRET=novacrm_dev_access_secret_change_me
JWT_REFRESH_SECRET=novacrm_dev_refresh_secret_change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PLATFORM_ADMIN_EMAIL=disabled@hmsenterprises.in
PLATFORM_ADMIN_PASSWORD=unused-single-tenant
# Platform / super-admin login is disabled — this app is HMS Enterprises only.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ASKMEISTER_API_BASE=https://api.askmeister.com
# Optional — admin "Ask HMS" on analytics. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Meta WhatsApp Cloud API — never commit real values
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Optional — set after Meta approves Utility templates (see docs/WHATSAPP_CLOUD_API_TEMPLATES.md)
# WHATSAPP_TEMPLATE_TICKET_ASSIGNED_ENGINEER=hms_ticket_assigned_engineer
# WHATSAPP_TEMPLATE_TICKET_CREATED=hms_ticket_created
# PUBLIC_API_URL=https://your-public-api-host
