# MySQL (AWS RDS). Shared RDS: keep connection_limit between 5–12 (API clamps to this band).
# Do NOT set 30–50 here — other apps on the same RDS need headroom.
# Example:
# DATABASE_URL="mysql://USER:PASSWORD@YOUR_RDS_HOST:3306/novacrm?sslaccept=accept_invalid_certs&connection_limit=8&pool_timeout=60&connect_timeout=15"
DATABASE_URL="mysql://user:password@127.0.0.1:3306/novacrm?connection_limit=8&pool_timeout=60&connect_timeout=15"
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174
REDIS_URL=none
REDIS_TTL_SECONDS=300
JWT_ACCESS_SECRET=novacrm_dev_access_secret_change_me_24chars
JWT_REFRESH_SECRET=novacrm_dev_refresh_secret_change_me_24
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Master platform console (/admin) — onboard clients, plans, modules. Not an HMS staff login.
PLATFORM_ADMIN_EMAIL=admin@novacrm.com
PLATFORM_ADMIN_PASSWORD=Admin@Nova2026
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ASKMEISTER_API_BASE=https://api.askmeister.com
# Optional — admin "Ask HMS" on analytics. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Meta WhatsApp Cloud API — never commit real values
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Optional — set after Meta approves Utility templates (see docs/WHATSAPP_CLOUD_API_TEMPLATES.md)
# WHATSAPP_TEMPLATE_TICKET_ASSIGNED_ENGINEER=hms_ticket_assigned_engineer
# WHATSAPP_TEMPLATE_TICKET_CREATED=hms_ticket_created

# Public HTTPS API origin for Meta webhook (no path, no trailing slash)
# Local: https://YOUR-NGROK-HOST   Live: https://YOUR-API.onrender.com
# PUBLIC_API_URL=https://novacrm-api.onrender.com
