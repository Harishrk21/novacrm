generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlatformAdminRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
}
enum PlatformAdminStatus {
  ACTIVE
  INACTIVE
}
enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}
enum TenantPlan {
  STARTER
  GROWTH
  BUSINESS
  ENTERPRISE
}
enum IsolationLevel {
  SHARED
  DEDICATED_SCHEMA
}
enum ModuleGroup {
  CRM
  ERP
  ENGAGEMENT
  SETTINGS
  REPORTS
}
enum CustomFieldType {
  TEXT
  NUMBER
  DECIMAL
  DATE
  DATETIME
  BOOLEAN
  SELECT
  MULTI_SELECT
  PHONE
  EMAIL
  URL
  TEXTAREA
  CURRENCY
}
enum TipType {
  TIP
  NOTE
  WARNING
  BEST_PRACTICE
}
enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  LOCKED
}
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  LOST
  CONVERTED
  DEMO
}
enum DealPriority {
  LOW
  MEDIUM
  HIGH
}
enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  WHATSAPP
  VISIT
  DEMO
}
enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
  OVERDUE
}
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}
enum MachineType {
  WEIGHING
  BILLING
  CCM
  CCTV
  BIOMETRIC
  PAPER_SHREDDER
  PAPER_ROLL
  OTHER
}
enum ServicePlan {
  AMC
  NON_AMC
}
enum SparePartChangeType {
  REPLACED
  INSTALLED
  REMOVED
  REPAIRED
  ADJUSTED
}
/// Machine bought from us (installed base) vs outside unit brought only for repair/service
enum AssetOrigin {
  SOLD_BY_US
  THIRD_PARTY
}
enum JobPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}
enum ProductType {
  GOODS
  SERVICE
  BUNDLE
}
enum StockMovementType {
  IN
  OUT
  ADJUST
  TRANSFER
  RETURN
}

enum StockUnitStatus {
  IN_STOCK
  DEMO
  SOLD
  RETURNED
}
enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}
enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}
enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}
enum PaymentDirection {
  INBOUND
  OUTBOUND
}
enum PaymentMethod {
  CASH
  UPI
  NEFT
  RTGS
  CHEQUE
  CARD
  OTHER
}
enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
}
enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}
enum MessageDirection {
  INBOUND
  OUTBOUND
}
enum WhatsappMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}
enum AuditActorType {
  PLATFORM_ADMIN
  USER
  SYSTEM
}

model PlatformAdmin {
  id           String              @id @db.Char(36)
  name         String              @db.VarChar(120)
  email        String              @unique @db.VarChar(191)
  passwordHash String              @map("password_hash") @db.VarChar(255)
  phone        String?             @db.VarChar(32)
  role         PlatformAdminRole   @default(SUPER_ADMIN)
  status       PlatformAdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?           @map("last_login_at") @db.DateTime(3)
  mfaSecret    String?             @map("mfa_secret") @db.VarChar(64)
  createdAt    DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime?           @map("deleted_at") @db.DateTime(3)
  @@map("platform_admins")
}

model BusinessCategory {
  id               String   @id @db.Char(36)
  code             String   @unique @db.VarChar(64)
  name             String   @db.VarChar(120)
  description      String?  @db.Text
  icon             String   @default("scale") @db.VarChar(64)
  colorHex         String   @default("#2563EB") @map("color_hex") @db.Char(7)
  defaultCurrency  String   @default("INR") @map("default_currency") @db.Char(3)
  defaultTimezone  String   @default("Asia/Kolkata") @map("default_timezone") @db.VarChar(64)
  defaultModules   Json     @map("default_modules")
  terminology      Json
  templateConfig   Json     @map("template_config")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)
  @@index([isActive, sortOrder])
  @@map("business_categories")
}

model Tenant {
  id                   String         @id @db.Char(36)
  code                 String         @unique @db.VarChar(32)
  name                 String         @db.VarChar(191)
  slug                 String         @unique @db.VarChar(64)
  businessCategoryId   String         @map("business_category_id") @db.Char(36)
  status               TenantStatus   @default(TRIAL)
  plan                 TenantPlan     @default(STARTER)
  isolationLevel       IsolationLevel @default(SHARED) @map("isolation_level")
  logoUrl              String?        @map("logo_url") @db.VarChar(512)
  website              String?        @db.VarChar(255)
  email                String?        @db.VarChar(191)
  phone                String?        @db.VarChar(32)
  gstin                String?        @db.VarChar(32)
  pan                  String?        @db.VarChar(16)
  addressLine1         String?        @map("address_line1") @db.VarChar(255)
  addressLine2         String?        @map("address_line2") @db.VarChar(255)
  city                 String?        @db.VarChar(100)
  state                String?        @db.VarChar(100)
  postalCode           String?        @map("postal_code") @db.VarChar(20)
  country              String         @default("IN") @db.Char(2)
  currency             String         @default("INR") @db.Char(3)
  timezone             String         @default("Asia/Kolkata") @db.VarChar(64)
  fiscalYearStartMonth Int            @default(4) @map("fiscal_year_start_month") @db.SmallInt
  maxUsers             Int            @default(10) @map("max_users")
  maxStorageMb         Int            @default(5120) @map("max_storage_mb")
  trialEndsAt          DateTime?      @map("trial_ends_at") @db.DateTime(3)
  activatedAt          DateTime?      @map("activated_at") @db.DateTime(3)
  suspendedAt          DateTime?      @map("suspended_at") @db.DateTime(3)
  modulesEnabled       Json           @map("modules_enabled")
  terminology          Json?
  branding             Json?
  settings             Json?
  createdByAdminId     String?        @map("created_by_admin_id") @db.Char(36)
  createdAt            DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt            DateTime?      @map("deleted_at") @db.DateTime(3)
  @@index([status])
  @@index([businessCategoryId])
  @@map("tenants")
}

model TenantModule {
  id          String      @id @db.Char(36)
  tenantId    String      @map("tenant_id") @db.Char(36)
  moduleKey   String      @map("module_key") @db.VarChar(64)
  moduleGroup ModuleGroup @map("module_group")
  label       String      @db.VarChar(120)
  isEnabled   Boolean     @default(true) @map("is_enabled")
  sortOrder   Int         @default(0) @map("sort_order")
  config      Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  @@unique([tenantId, moduleKey])
  @@index([tenantId, moduleGroup, isEnabled])
  @@map("tenant_modules")
}

model CustomFieldDefinition {
  id           String          @id @db.Char(36)
  tenantId     String          @map("tenant_id") @db.Char(36)
  entityType   String          @map("entity_type") @db.VarChar(64)
  fieldKey     String          @map("field_key") @db.VarChar(64)
  label        String          @db.VarChar(120)
  fieldType    CustomFieldType @map("field_type")
  optionsJson  Json?           @map("options_json")
  isRequired   Boolean         @default(false) @map("is_required")
  isUnique     Boolean         @default(false) @map("is_unique")
  isSearchable Boolean         @default(true) @map("is_searchable")
  isVisible    Boolean         @default(true) @map("is_visible")
  sortOrder    Int             @default(0) @map("sort_order")
  helpText     String?         @map("help_text") @db.VarChar(255)
  validation   Json?
  createdAt    DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime?       @map("deleted_at") @db.DateTime(3)
  @@unique([tenantId, entityType, fieldKey])
  @@index([tenantId, entityType, isVisible])
  @@map("custom_field_definitions")
}

model FeatureTip {
  id         String   @id @db.Char(36)
  tenantId   String?  @map("tenant_id") @db.Char(36)
  moduleKey  String   @map("module_key") @db.VarChar(64)
  sectionKey String   @map("section_key") @db.VarChar(64)
  title      String   @db.VarChar(160)
  body       String   @db.Text
  tipType    TipType  @default(TIP) @map("tip_type")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  @@index([tenantId, moduleKey, sectionKey, isActive])
  @@map("feature_tips")
}

model Role {
  id          String    @id @db.Char(36)
  tenantId    String    @map("tenant_id") @db.Char(36)
  code        String    @db.VarChar(64)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(255)
  isSystem    Boolean   @default(false) @map("is_system")
  permissions Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  @@unique([tenantId, code])
  @@map("roles")
}

model User {
  id           String     @id @db.Char(36)
  tenantId     String     @map("tenant_id") @db.Char(36)
  roleId       String     @map("role_id") @db.Char(36)
  name         String     @db.VarChar(120)
  email        String     @db.VarChar(191)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  phone        String?    @db.VarChar(32)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(512)
  status       UserStatus @default(INVITED)
  timezone     String     @default("Asia/Kolkata") @db.VarChar(64)
  locale       String     @default("en-IN") @db.VarChar(16)
  lastLoginAt  DateTime?  @map("last_login_at") @db.DateTime(3)
  invitedAt    DateTime?  @map("invited_at") @db.DateTime(3)
  invitedBy    String?    @map("invited_by") @db.Char(36)
  preferences  Json?
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime?  @map("deleted_at") @db.DateTime(3)
  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id              String    @id @db.Char(36)
  userId          String?   @map("user_id") @db.Char(36)
  platformAdminId String?   @map("platform_admin_id") @db.Char(36)
  tokenHash       String    @unique @map("token_hash") @db.VarChar(128)
  userAgent       String?   @map("user_agent") @db.VarChar(255)
  ipAddress       String?   @map("ip_address") @db.VarChar(64)
  expiresAt       DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt       DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  @@index([userId])
  @@index([platformAdminId])
  @@map("refresh_tokens")
}

model PipelineStage {
  id          String   @id @db.Char(36)
  tenantId    String   @map("tenant_id") @db.Char(36)
  name        String   @db.VarChar(80)
  code        String   @db.VarChar(40)
  colorHex    String   @default("#2563EB") @map("color_hex") @db.Char(7)
  probability Int      @default(20) @db.SmallInt
  sortOrder   Int      @default(0) @map("sort_order")
  isWon       Boolean  @default(false) @map("is_won")
  isLost      Boolean  @default(false) @map("is_lost")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  @@unique([tenantId, code])
  @@index([tenantId, sortOrder])
  @@map("pipeline_stages")
}

model LeadSource {
  id        String   @id @db.Char(36)
  tenantId  String   @map("tenant_id") @db.Char(36)
  name      String   @db.VarChar(80)
  code      String   @db.VarChar(40)
  colorHex  String   @default("#64748B") @map("color_hex") @db.Char(7)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  @@unique([tenantId, code])
  @@map("lead_sources")
}

model Account {
  id              String    @id @db.Char(36)
  tenantId        String    @map("tenant_id") @db.Char(36)
  name            String    @db.VarChar(191)
  accountType     String?   @map("account_type") @db.VarChar(64)
  industry        String?   @db.VarChar(100)
  website         String?   @db.VarChar(255)
  phone           String?   @db.VarChar(32)
  email           String?   @db.VarChar(191)
  gstin           String?   @db.VarChar(32)
  pan             String?   @db.VarChar(16)
  billingAddress  Json?     @map("billing_address")
  shippingAddress Json?     @map("shipping_address")
  city            String?   @db.VarChar(100)
  state           String?   @db.VarChar(100)
  country         String    @default("IN") @db.Char(2)
  ownerUserId     String?   @map("owner_user_id") @db.Char(36)
  annualRevenue   Decimal?  @map("annual_revenue") @db.Decimal(15, 2)
  employeeCount   Int?      @map("employee_count")
  description     String?   @db.Text
  tags            Json?
  customFields    Json?     @map("custom_fields")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)
  @@index([tenantId, name])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, phone])
  @@map("accounts")
}

model Contact {
  id              String    @id @db.Char(36)
  tenantId        String    @map("tenant_id") @db.Char(36)
  /// Human-facing unique customer number within the workspace (e.g. 42 → CUS-00042)
  customerNo      Int?      @map("customer_no") @db.Int
  /// Display / scan ID — unique per tenant (CUS-00042)
  customerCode    String?   @map("customer_code") @db.VarChar(32)
  accountId       String?   @map("account_id") @db.Char(36)
  name            String    @db.VarChar(120)
  email           String?   @db.VarChar(191)
  phone           String?   @db.VarChar(32)
  mobile          String?   @db.VarChar(32)
  phoneNormalized String?   @map("phone_normalized") @db.VarChar(20)
  title           String?   @db.VarChar(120)
  department      String?   @db.VarChar(120)
  street          String?   @db.VarChar(255)
  doorNo          String?   @map("door_no") @db.VarChar(64)
  area            String?   @db.VarChar(120)
  pincode         String?   @db.VarChar(20)
  location        String?   @db.VarChar(255)
  city            String?   @db.VarChar(100)
  state           String?   @db.VarChar(100)
  country         String    @default("IN") @db.Char(2)
  ownerUserId     String?   @map("owner_user_id") @db.Char(36)
  tags            Json?
  description     String?   @db.Text
  customFields    Json?     @map("custom_fields")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)
  @@unique([tenantId, customerNo])
  @@unique([tenantId, customerCode])
  @@index([tenantId, name])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, email])
  @@index([tenantId, accountId])
  @@map("contacts")
}

model Lead {
  id                 String     @id @db.Char(36)
  tenantId           String     @map("tenant_id") @db.Char(36)
  name               String     @db.VarChar(120)
  email              String?    @db.VarChar(191)
  phone              String?    @db.VarChar(32)
  phoneNormalized    String?    @map("phone_normalized") @db.VarChar(20)
  company            String?    @db.VarChar(191)
  website            String?    @db.VarChar(255)
  city               String?    @db.VarChar(100)
  state              String?    @db.VarChar(100)
  country            String     @default("IN") @db.Char(2)
  sourceId           String?    @map("source_id") @db.Char(36)
  status             LeadStatus @default(NEW)
  score              Int        @default(0) @db.SmallInt
  assignedToId       String?    @map("assigned_to_id") @db.Char(36)
  createdById        String     @map("created_by_id") @db.Char(36)
  convertedContactId String?    @map("converted_contact_id") @db.Char(36)
  convertedAccountId String?    @map("converted_account_id") @db.Char(36)
  convertedDealId    String?    @map("converted_deal_id") @db.Char(36)
  convertedAt        DateTime?  @map("converted_at") @db.DateTime(3)
  description        String?    @db.Text
  tags               Json?
  customFields       Json?      @map("custom_fields")
  lastActivityAt     DateTime?  @map("last_activity_at") @db.DateTime(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt          DateTime?  @map("deleted_at") @db.DateTime(3)
  @@index([tenantId, status, createdAt])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, assignedToId])
  @@index([tenantId, sourceId])
  @@map("leads")
}

model Deal {
  id                String       @id @db.Char(36)
  tenantId          String       @map("tenant_id") @db.Char(36)
  name              String       @db.VarChar(191)
  amount            Decimal      @default(0) @db.Decimal(15, 2)
  currency          String       @default("INR") @db.Char(3)
  stageId           String       @map("stage_id") @db.Char(36)
  priority          DealPriority @default(MEDIUM)
  probability       Int          @default(20) @db.SmallInt
  expectedCloseDate DateTime?    @map("expected_close_date") @db.Date
  closedAt          DateTime?    @map("closed_at") @db.DateTime(3)
  lostReason        String?      @map("lost_reason") @db.VarChar(255)
  contactId         String?      @map("contact_id") @db.Char(36)
  accountId         String?      @map("account_id") @db.Char(36)
  ownerUserId       String?      @map("owner_user_id") @db.Char(36)
  description       String?      @db.Text
  customFields      Json?        @map("custom_fields")
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt         DateTime?    @map("deleted_at") @db.DateTime(3)
  @@index([tenantId, stageId])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, expectedCloseDate])
  @@map("deals")
}

model Activity {
  id              String         @id @db.Char(36)
  tenantId        String         @map("tenant_id") @db.Char(36)
  type            ActivityType
  title           String         @db.VarChar(191)
  description     String?        @db.Text
  status          ActivityStatus @default(PENDING)
  scheduledAt     DateTime?      @map("scheduled_at") @db.DateTime(3)
  completedAt     DateTime?      @map("completed_at") @db.DateTime(3)
  durationMinutes Int?           @map("duration_minutes")
  outcome         String?        @db.VarChar(255)
  leadId          String?        @map("lead_id") @db.Char(36)
  contactId       String?        @map("contact_id") @db.Char(36)
  dealId          String?        @map("deal_id") @db.Char(36)
  accountId       String?        @map("account_id") @db.Char(36)
  assignedToId    String?        @map("assigned_to_id") @db.Char(36)
  customFields    Json?          @map("custom_fields")
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime?      @map("deleted_at") @db.DateTime(3)
  @@index([tenantId, scheduledAt])
  @@index([tenantId, contactId])
  @@index([tenantId, leadId])
  @@index([tenantId, type, status])
  @@map("activities")
}

model Ticket {
  id               String         @id @db.Char(36)
  tenantId         String         @map("tenant_id") @db.Char(36)
  ticketNo         Int            @map("ticket_no") @db.Int
  subject          String         @db.VarChar(255)
  description      String         @db.Text
  priority         TicketPriority @default(MEDIUM)
  status           TicketStatus   @default(OPEN)
  slaDueAt         DateTime?      @map("sla_due_at") @db.DateTime(3)
  slaBreached      Boolean        @default(false) @map("sla_breached")
  contactId        String?        @map("contact_id") @db.Char(36)
  accountId        String?        @map("account_id") @db.Char(36)
  assignedToId     String?        @map("assigned_to_id") @db.Char(36)
  productId        String?        @map("product_id") @db.Char(36)
  assetId          String?        @map("asset_id") @db.Char(36)
  stampingDate     DateTime?      @map("stamping_date") @db.Date
  nextDueDate      DateTime?      @map("next_due_date") @db.Date
  odAmount         Decimal        @default(0) @map("od_amount") @db.Decimal(15, 2)
  paymentTotal     Decimal        @default(0) @map("payment_total") @db.Decimal(15, 2)
  advanceAmount    Decimal        @default(0) @map("advance_amount") @db.Decimal(15, 2)
  paymentStatus    JobPaymentStatus @default(UNPAID) @map("payment_status")
  paidAt           DateTime?      @map("paid_at") @db.DateTime(3)
  receivedByUserId String?        @map("received_by_user_id") @db.Char(36)
  deliveredByUserId String?       @map("delivered_by_user_id") @db.Char(36)
  customFields     Json?          @map("custom_fields")
  resolvedAt       DateTime?      @map("resolved_at") @db.DateTime(3)
  closedAt         DateTime?      @map("closed_at") @db.DateTime(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
