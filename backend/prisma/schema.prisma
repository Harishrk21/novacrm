  @@index([tenantId, isActive])
  @@map("automation_rules")
}

model AuditLog {
  id         String         @id @db.Char(36)
  tenantId   String?        @map("tenant_id") @db.Char(36)
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Char(36)
  action     String         @db.VarChar(64)
  entityType String?        @map("entity_type") @db.VarChar(64)
  entityId   String?        @map("entity_id") @db.Char(36)
  ipAddress  String?        @map("ip_address") @db.VarChar(64)
  userAgent  String?        @map("user_agent") @db.VarChar(255)
  beforeJson Json?          @map("before_json")
  afterJson  Json?          @map("after_json")
  createdAt  DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

model NumberSequence {
  tenantId    String   @map("tenant_id") @db.Char(36)
  sequenceKey String   @map("sequence_key") @db.VarChar(40)
  prefix      String   @default("") @db.VarChar(20)
  nextValue   Int      @default(1) @map("next_value") @db.Int
  padding     Int      @default(5) @db.SmallInt
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  @@id([tenantId, sequenceKey])
  @@map("number_sequences")
}
